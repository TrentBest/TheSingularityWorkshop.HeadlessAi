<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>TheSingularityWorkshop.HeadlessAi</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Provider-neutral HTTP agent primitives with explicit endpoint-specific request and response adapters.</Description>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.HeadlessAi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.HeadlessAi</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>http;agents;llm;provider-adapter;headless</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <!-- Development builds consume the dependency's development source, never a published NuGet package. -->
  <ItemGroup Condition="'$(UsePublishedDependencies)' != 'true'">
    <ProjectReference Include="../../../dependencies/FSM_Serialization/TheSingularityWorkshop.FSM_Serialization.csproj" />
  </ItemGroup>
  <!-- Release packaging opts into the already-approved published dependency explicitly. -->
  <ItemGroup Condition="'$(UsePublishedDependencies)' == 'true'">
    <PackageReference Include="TheSingularityWorkshop.FSM_Serialization" Version="$(FsmSerializationPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/**/*.md" Pack="true" PackagePath="docs/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../docs/**/*.svg" Pack="true" PackagePath="docs/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
